{
  "version": "v1",
  "hooks": [
    {
      "name": "Block credentials in file writes",
      "trigger": "PreToolUse",
      "matcher": "fs_write|str_replace|fs_append|write|replace|append|edit",
      "action": {
        "type": "command",
        "command": "python3 .kiro/hooks/scripts/check_secrets.py"
      }
    }
  ]
}
